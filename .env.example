# Password to log into the CRM
APP_PASSWORD=change-me
# Long random string - encrypts your email passwords. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Public web address of this app (used for unsubscribe links + the seller form)
PUBLIC_URL=http://localhost:3000
PORT=3000
# Your timezone, so sending windows (e.g. 9am-6pm) are correct
TZ=America/New_York
# Set to 1 to test without actually sending email (emails are logged instead)
DRY_RUN=0
